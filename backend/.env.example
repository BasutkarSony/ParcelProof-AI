# PayPal Developer Dashboard > Apps & Credentials > Sandbox > your REST app
# Use the REST app Client ID and Secret, not legacy NVP/SOAP credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Frontend origin used to build PayPal return/cancel URLs.
FRONTEND_URL=http://localhost:5173
# Optional shared Basic Auth for a public demo; leave blank for local development.
# A partial configuration fails closed. Render requires these values.
PARCELPROOF_DEMO_AUTH_REQUIRED=false
PARCELPROOF_DEMO_USERNAME=
PARCELPROOF_DEMO_PASSWORD=

# Optional overrides for hosted deployments.
# PAYPAL_RETURN_URL=https://your-domain.example/checkout/return
# PAYPAL_CANCEL_URL=https://your-domain.example/checkout/cancel
# Keep false unless you have explicitly approved a PayPal Sandbox tracking write.
PAYPAL_TRACKING_SUBMISSION_ENABLED=false

# Google Gemini — obtain from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=
# Optional: override the Gemini model. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI vision fallback used when Gemini is unavailable (or unset).
# Obtain a separate API key from the OpenAI developer platform.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_TIMEOUT_SECONDS=90

# Optional remote PostgreSQL persistence. When set, the backend runs the
# checked-in SQL migrations and uses this database instead of local SQLite.
# For Supabase use the Session Pooler connection string with SSL enabled.
DATABASE_URL=
# Set true on hosted services so missing DB configuration cannot silently use SQLite.
PARCELPROOF_REQUIRE_DATABASE=false
# Defaults to require; use disable only for an isolated local PostgreSQL test service.
DATABASE_SSLMODE=require

# Supabase private persistence (backend only; never expose these keys to the frontend).
SUPABASE_URL=
# New sb_secret_* API key. Used as the apikey header.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT. Required by the private Storage REST API as its Bearer token
# when SUPABASE_SECRET_KEY uses the new sb_secret_* format.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inspection-photos
