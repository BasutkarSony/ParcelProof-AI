# PayPal Developer Dashboard > Apps & Credentials > Sandbox > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Frontend origin used to build PayPal return/cancel URLs.
FRONTEND_URL=http://localhost:5173

# Optional shared in-app demo sign-in. Enable and fill all values for a shared demo.
PARCELPROOF_DEMO_AUTH_REQUIRED=false
PARCELPROOF_DEMO_USERNAME=
PARCELPROOF_DEMO_PASSWORD=
PARCELPROOF_DEMO_SESSION_SECRET=

# Sandbox tracking writes stay disabled for the hackathon demo.
PAYPAL_TRACKING_SUBMISSION_ENABLED=false

# Hosted demo uses Gemini as its only configured vision provider.
PACKING_VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# Optional OpenAI vision fallback. Leave blank unless separately configured.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_TIMEOUT_SECONDS=90

# Optional remote PostgreSQL. Local development uses SQLite when blank.
DATABASE_URL=
PARCELPROOF_REQUIRE_DATABASE=false
DATABASE_SSLMODE=require

# Supabase private persistence (backend only; never expose these in the browser).
# Required for the hosted Postgres and private Storage setup.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inspection-photos
SUPABASE_DOCUMENTS_BUCKET=shipment-documents
